PROJECT_NAME=BuildingPulse AI
ENVIRONMENT=development

# Network Ports (isolated to prevent collision with other host services)
WEB_PORT=5180
API_PORT=8050
DB_PORT=5455

# Database Configuration
# For local running without Docker, use SQLite:
DATABASE_URL=sqlite:///./buildingpulse.db
# For Docker Compose, the container uses:

POSTGRES_USER=buildingpulse
POSTGRES_PASSWORD=
POSTGRES_DB=buildingpulse_db

# Data directories
DATA_ROOT=./data

# Security / CORS
CORS_ORIGINS=["http://localhost:5180","http://127.0.0.1:5180","http://localhost:8050","http://127.0.0.1:8050"]
