            "title": "Arm",
            "type": "string"
          },
          "both_tp": {
            "title": "Both Tp",
            "type": "integer"
          },
          "comparator": {
            "title": "Comparator",
            "type": "string"
          },
          "comparator_fp": {
            "title": "Comparator Fp",
            "type": "integer"
          },
          "comparator_tp": {
            "title": "Comparator Tp",
            "type": "integer"
          },
          "detector": {
            "const": "SYSTEM_MAX_8",
            "default": "SYSTEM_MAX_8",
            "title": "Detector",
            "type": "string"
          },
          "evidence": {
            "const": "REPRO_01_SAVED_DAILY_CSV",
            "default": "REPRO_01_SAVED_DAILY_CSV",
            "title": "Evidence",
            "type": "string"
          },
          "lgbm_fp": {
            "title": "Lgbm Fp",
            "type": "integer"
          },
          "lgbm_tp": {
            "title": "Lgbm Tp",
            "type": "integer"
          },
          "paired_days": {
            "title": "Paired Days",
            "type": "integer"
          }
        },
        "required": [
          "arm",
          "comparator",
          "paired_days",
          "lgbm_tp",
          "comparator_tp",
          "lgbm_fp",
          "comparator_fp",
          "both_tp"
        ],
        "title": "BaselineComparison",
        "type": "object"
      },
      "Case": {
        "properties": {
          "alias_status": {
            "enum": [
              "PUBLISHER_BASELINE",
              "UNVERIFIED_PUBLISHER_ALIAS"
            ],
            "title": "Alias Status",
            "type": "string"
          },
          "days": {
            "items": {
              "type": "string"
            },
            "title": "Days",
            "type": "array"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "member": {
            "title": "Member",
            "type": "string"
          },
          "member_sha256": {
            "title": "Member Sha256",
            "type": "string"
          }
        },
        "required": [
          "id",
          "label",
          "member",
          "member_sha256",
          "alias_status",
          "days"
        ],
        "title": "Case",
        "type": "object"
      },
      "Day": {
        "properties": {
          "alert": {
            "anyOf": [
              {
                "const": "MODEL_ANOMALY",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Alert"
          },
          "calendar_minutes": {
            "const": 1440,
            "default": 1440,
            "title": "Calendar Minutes",
            "type": "integer"
          },
          "case": {
            "$ref": "#/components/schemas/Case"
          },
          "continuous_minutes": {
            "default": 0,
            "title": "Continuous Minutes",
            "type": "integer"
          },
          "coverage": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Coverage",
            "type": "number"
          },
          "daily_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Daily Score"
          },
          "day": {
            "title": "Day",
            "type": "string"
          },
          "evaluated_minutes": {
            "title": "Evaluated Minutes",
            "type": "integer"
          },
          "metadata": {
            "$ref": "#/components/schemas/Metadata"
          },
          "method": {
            "const": "SAT_ONLY",
            "default": "SAT_ONLY",
            "title": "Method",
            "type": "string"
          },
          "points": {
            "items": {
              "$ref": "#/components/schemas/Point"
            },
            "title": "Points",
            "type": "array"
          },
          "present_channels": {
            "items": {
              "type": "string"
            },
            "title": "Present Channels",
            "type": "array"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "running_minutes": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Running Minutes"
          },
          "status": {
            "enum": [
              "EVALUATED",
              "NOT_EVALUABLE",
              "INSUFFICIENT_COVERAGE"
            ],
            "title": "Status",
            "type": "string"
          },
          "threshold": {
            "const": 3,
            "default": 3,
            "title": "Threshold",
            "type": "integer"
          }
        },
        "required": [
          "status",
          "case",
          "day",
          "metadata",
          "evaluated_minutes",
          "coverage",
          "points",
          "present_channels"
        ],
        "title": "Day",
        "type": "object"
      },
      "EvidenceBoundary": {
        "properties": {
          "alarm_meaning": {
            "const": "MODEL_RESIDUAL_ONLY",
            "default": "MODEL_RESIDUAL_ONLY",
            "title": "Alarm Meaning",
            "type": "string"
          },
          "cohort": {
            "const": "PREVIOUSLY_INSPECTED_SIMULATION",
            "default": "PREVIOUSLY_INSPECTED_SIMULATION",
            "title": "Cohort",
            "type": "string"
          },
          "external_validation": {
            "const": "BLOCKED_EXTERNAL_VALIDATION",
            "default": "BLOCKED_EXTERNAL_VALIDATION",
            "title": "External Validation",
            "type": "string"
          }
        },
        "title": "EvidenceBoundary",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Metadata": {
        "properties": {
          "arm": {
            "const": "PRODUCT_BASIC",
            "default": "PRODUCT_BASIC",
            "title": "Arm",
            "type": "string"
          },
          "available_channels": {
            "items": {
              "type": "string"
            },
            "title": "Available Channels",
            "type": "array"
          },
          "cases": {
            "items": {
              "$ref": "#/components/schemas/Case"
            },
            "title": "Cases",
            "type": "array"
          },
          "comparisons": {
            "items": {
              "$ref": "#/components/schemas/BaselineComparison"
            },
            "title": "Comparisons",
            "type": "array"
          },
          "evidence_boundary": {
            "$ref": "#/components/schemas/EvidenceBoundary"
          },
          "feature_order": {
            "items": {
              "type": "string"
            },
            "title": "Feature Order",
            "type": "array"
          },
          "feature_roles": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Feature Roles",
            "type": "object"
          },
          "integration_protocol_sha256": {
            "title": "Integration Protocol Sha256",
            "type": "string"
          },
          "methods": {
            "items": {
              "$ref": "#/components/schemas/ResearchMethod"
            },
            "title": "Methods",
            "type": "array"
          },
          "mode": {
            "title": "Mode",
            "type": "string"
          },
          "model_id": {
            "title": "Model Id",
            "type": "string"
          },
          "policy_version": {
            "const": "sat-daily-coverage@1.0.0",
            "default": "sat-daily-coverage@1.0.0",
            "title": "Policy Version",
            "type": "string"
          },
          "protocol_sha256": {
            "title": "Protocol Sha256",
            "type": "string"
          },
          "schema_sha256": {
            "title": "Schema Sha256",
            "type": "string"
          },
          "scope": {
            "const": "SIMULATED_BENCHMARK",
            "default": "SIMULATED_BENCHMARK",
            "title": "Scope",
            "type": "string"
          },
          "source_sha256": {
            "title": "Source Sha256",
            "type": "string"
          },
          "source_timezone": {
            "title": "Source Timezone",
            "type": "string"
          },
          "split": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Split",
            "type": "object"
          },
          "timestamp_format": {
            "title": "Timestamp Format",
            "type": "string"
          },
          "ttl_sha256": {
            "title": "Ttl Sha256",
            "type": "string"
          },
          "use": {
            "const": "RESEARCH_ONLY",
            "default": "RESEARCH_ONLY",
            "title": "Use",
            "type": "string"
          },
          "versions": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Versions",
            "type": "object"
          }
        },
        "required": [
          "source_sha256",
          "ttl_sha256",
          "schema_sha256",
          "protocol_sha256",
          "integration_protocol_sha256",
          "source_timezone",
          "timestamp_format",
          "model_id",
          "mode",
          "split",
          "versions",
          "feature_order",
          "available_channels",
          "feature_roles",
          "cases",
          "evidence_boundary",
          "methods",
          "comparisons"
