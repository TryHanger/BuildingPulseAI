      },
      "Point": {
        "properties": {
          "absolute_residual": {
            "title": "Absolute Residual",
            "type": "number"
          },
          "actual": {
            "title": "Actual",
            "type": "number"
          },
          "predicted": {
            "title": "Predicted",
            "type": "number"
          },
          "timestamp": {
            "title": "Timestamp",
            "type": "string"
          },
          "z": {
            "title": "Z",
            "type": "number"
          }
        },
        "required": [
          "timestamp",
          "actual",
          "predicted",
          "absolute_residual",
          "z"
        ],
        "title": "Point",
        "type": "object"
      },
      "ResearchMethod": {
        "properties": {
          "availability": {
            "enum": [
              "ARCHIVE_DAY_API",
              "FULL_COHORT_RESEARCH_REPORT"
            ],
            "title": "Availability",
            "type": "string"
          },
          "id": {
            "enum": [
              "SAT_ONLY",
              "SYSTEM_MAX_8",
              "SAT_MINUS_SETPOINT"
            ],
            "title": "Id",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "id",
          "version",
          "availability"
        ],
        "title": "ResearchMethod",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "BuildingPulse Virtual Sensor Research",
    "version": "1.2.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/research/virtual-sensors": {
      "get": {
        "operationId": "metadata_api_research_virtual_sensors_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Metadata"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "description": "Trusted research registry disabled or unavailable"
          }
        },
        "summary": "Metadata",
        "tags": [
          "Research virtual sensors"
        ]
      }
    },
    "/api/research/virtual-sensors/day": {
      "get": {
        "description": "Select one case and one source-local day from the pinned SAT archive.",
        "operationId": "research_day_api_research_virtual_sensors_day_get",
        "parameters": [
          {
            "in": "query",
            "name": "case",
            "required": true,
            "schema": {
              "enum": [
                "healthy",
                "sa-plus-2"
              ],
              "title": "Case",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "day",
            "required": true,
            "schema": {
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "title": "Day",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Day"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "Day outside archived research window"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "description": "Trusted research registry disabled or unavailable"
          }
        },
        "summary": "Research Day",
        "tags": [
          "Research virtual sensors"
        ]
      }
    }
  }
}
