  "info": {
    "title": "BuildingPulse Research Applicability",
    "version": "1.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/research/domain-shift-07": {
      "get": {
        "description": "Return frozen candidate metadata and its negative external transfer gate.",
        "operationId": "reduced_sat_contract_api_research_domain_shift_07_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReducedSATResearchContract"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Reduced Sat Contract",
        "tags": [
          "Research applicability"
        ]
      }
    },
    "/api/research/domain-shift-07/applicability": {
      "post": {
        "description": "Check prospective applicability metadata without scoring or emitting incidents.",
        "operationId": "reduced_sat_applicability_api_research_domain_shift_07_applicability_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApplicabilityRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApplicabilityResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Reduced Sat Applicability",
        "tags": [
          "Research applicability"
        ]
      }
    }
  }
